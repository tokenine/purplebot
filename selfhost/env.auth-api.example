# Account service (Cloudflare Worker) settings. Copy to selfhost/.env.auth-api and fill in.
# deploy.sh auth reads this file. Use plain values: no spaces and no quotes.
# Git ignores selfhost/.env.* .

# The origin of your account service. A custom domain on your Cloudflare zone.
API_DOMAIN=https://purple-api.example.com

# Worker name on your account. Keep it unique inside your Cloudflare account.
WORKER_NAME=purplebot-auth-api

# D1 database. deploy.sh creates it and fills D1_DATABASE_ID for you.
D1_DATABASE_NAME=purplebot-auth
D1_DATABASE_ID=

# R2 buckets for avatars, skills and published sites.
R2_AVATARS_BUCKET=purplebot-avatars
R2_SKILLS_BUCKET=purplebot-skills
R2_SITES_BUCKET=purplebot-sites

# Your Linux server. It runs Signal, TURN, the email hook and the PurpleBot server.
# Signal and TURN need two A records that point at it (DNS only, no proxy).
SSH_USER_AT_HOST=root@203.0.113.10
SELFHOST_DIR=/data/purplebot
SIGNAL_DOMAIN=signal.example.com
TURN_DOMAIN=turn.example.com
TURN_PUBLIC_IP=203.0.113.10
ACME_EMAIL=admin@example.com

# The Signal address that the Worker hands to clients, and the webhook that
# Signal calls on the Worker. Keep the /v1/signal and /internal/auth-events paths.
REMOTE_SIGNAL_URL=wss://signal.example.com/v1/signal
REMOTE_AUTH_WEBHOOK_URL=https://signal.example.com/internal/auth-events

# Ticket key id. Change the number when you replace the key pair.
REMOTE_TICKET_KEY_ID=purplebot-remote-1

# Sign-in codes go out by email.
#
# EMAIL_DELIVERY_MODE=webhook (default, tested): the Worker posts each code to the
#   email hook on your Linux server, and the hook sends it with curl over SMTP.
#   EMAIL_DELIVERY_WEBHOOK_URL is https://<SIGNAL_DOMAIN>:2053/email-code.
# EMAIL_DELIVERY_MODE=smtp: the Worker sends the mail with its own SMTP client.
#   Not tested: a Worker does not always get a reply from an SMTP port.
#
# The SMTP account (Cloudflare: Email Routing > SMTP): create the credential in
# the dashboard, then set the host, the port, the user "api_token" and the token
# as the password. EMAIL_FROM must be a verified sender of that domain.
EMAIL_DELIVERY_MODE=webhook
EMAIL_DELIVERY_WEBHOOK_URL=https://signal.example.com:2053/email-code
EMAIL_SMTP_HOST=smtp.mx.cloudflare.net
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USERNAME=api_token
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=no_reply@example.com
EMAIL_REPLY_TO=

# Hosted servers are a nightly-labs service. Keep false.
HOSTED_SERVERS_ENABLED=false
