# Signal and TURN settings for selfhost/compose.signal.yaml. Do not edit a copy:
# deploy.sh auth writes selfhost/.env.signal from this file, with your domains
# from selfhost/.env.auth-api and the generated secrets.

ACME_EMAIL=admin@example.com
SIGNAL_DOMAIN=signal.example.com
TURN_DOMAIN=turn.example.com
TURN_PUBLIC_IP=203.0.113.10
REMOTE_SIGNAL_BIND_ADDRESS=0.0.0.0
REMOTE_SIGNAL_PUBLIC_PORT=443
REMOTE_SIGNAL_PORT=8443
REMOTE_TLS_DISABLED=false

# The next three values and the secrets come from selfhost/.env.auth-api.
REMOTE_TICKET_JWKS_URL=https://purple-api.example.com/.well-known/jwks.json
REMOTE_CONTROL_PLANE_URL=https://purple-api.example.com
REMOTE_SESSION_SECRET=
REMOTE_AUTH_WEBHOOK_SECRET=
REMOTE_METRICS_TOKEN=
TURN_SHARED_SECRET=

REMOTE_MAX_CONNECTIONS_PER_USER=32
REMOTE_MAX_CONNECTIONS_PER_IP=32
REMOTE_MAX_MESSAGES_PER_MINUTE=600
REMOTE_TRUST_PROXY=false

# Chat-platform bridges. Leave empty to disable.
SLACK_SIGNING_SECRET=
GITHUB_WEBHOOK_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_MESSAGE_CONTENT=
TELEGRAM_BOT_TOKENS=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_ORIGIN=https://signal.example.com
